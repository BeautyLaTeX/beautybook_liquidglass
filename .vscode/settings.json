{
  "latex-workshop.latex.tools": [
    {
      "name": "beautybook-auto",
      "command": "/bin/sh",
      "args": [
        "%WORKSPACE_FOLDER%/build.command",
        "%DOC_EXT%",
        "--no-pause",
        "--no-open",
        "--sync-next-to-pdf"
      ],
      "cwd": "%DIR%"
    },
    {
      "name": "liquidglass-1.6",
      "command": "/opt/homebrew/bin/python3",
      "args": [
        "%WORKSPACE_FOLDER%/lgbuild.py",
        "%DOC_EXT%"
      ],
      "cwd": "%DIR%"
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "Beautybook 自动编译（普通与玻璃）",
      "tools": [
        "beautybook-auto"
      ]
    },
    {
      "name": "LiquidGlass 1.6",
      "tools": [
        "liquidglass-1.6"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "Beautybook 自动编译（普通与玻璃）",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.outDir": "%DIR%",
  "latex-workshop.latex.auxDir": "%DIR%/build",
  "latex-workshop.view.pdf.viewer": "tab"
}
