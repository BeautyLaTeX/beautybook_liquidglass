{
  "liquidglassLatexStudio.python": "/Users/ethanlu/Documents/ai 工作区/.beautybook_liquidglass.venv/bin/python",
  "latex-workshop.latex.tools": [
    {
      "name": "beautybook-auto",
      "command": "/bin/sh",
      "args": [
        "%WORKSPACE_FOLDER%/build.command",
        "%DOC_EXT%",
        "--no-pause",
        "--no-open",
        "--sync-next-to-pdf"
      ],
      "cwd": "%DIR%"
    },
    {
      "name": "liquidglass-2.0",
      "command": "/bin/sh",
      "args": [
        "%WORKSPACE_FOLDER%/build.command",
        "%DOC_EXT%",
        "--glass",
        "--no-pause",
        "--no-open",
        "--sync-next-to-pdf"
      ],
      "cwd": "%DIR%"
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "Beautybook 自动编译（普通与玻璃）",
      "tools": [
        "beautybook-auto"
      ]
    },
    {
      "name": "LiquidGlass 2.0（直接构建）",
      "tools": [
        "liquidglass-2.0"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "Beautybook 自动编译（普通与玻璃）",
  "latex-workshop.latex.autoBuild.run": "never",
  "latex-workshop.latex.outDir": "%DIR%",
  "latex-workshop.latex.auxDir": "%DIR%/build",
  "latex-workshop.view.pdf.viewer": "tab"
}
