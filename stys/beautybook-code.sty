  fuzzy shadow={0mm}{-.4mm}{.7mm}{.06mm}{white!10},
  fuzzy shadow={0mm}{2.5mm}{7mm}{.20mm}{black!38},
  fuzzy shadow={0mm}{8mm}{20mm}{.28mm}{black!22},
  underlay unbroken={\MacDarkGlassBody},
  underlay first={\MacDarkGlassBody},
  underlay middle={\MacDarkGlassBody},
