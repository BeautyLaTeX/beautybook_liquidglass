% =========================================================
% Light listing environment / 浅色代码环境
%
% 用法：
% \begin{maccode}[局部 minted 选项]{语言}{标题}
% ...
% \end{maccode}
% =========================================================
\newtcblisting{maccode}[3][]{%
  enhanced jigsaw,
  beautybook code breaks,
  listing only,
  listing engine=minted,
  minted language=#2,
  minted options={
      style=xcode,
      fontsize=\small,
      frame=leftline,
      framesep=5pt,
      framerule=.36pt,
      rulecolor=\color{MacLGutterLine},
      linenos=true,
      numberblanklines=false,
      numbersep=4pt,
      breaklines=true,
      breakanywhere=true,
      autogobble=true,
      tabsize=4,
      ignorelexererrors=true,
      breakautoindent=true,
      breakindent=1.2em,
      breaksymbolleft={},
      #1
  },
  width=\MacWindowWidth,
  center,
  boxrule=0pt,
  frame hidden,
  colback=white,
  opacityback=0,
  arc=\MacRadius,
  outer arc=\MacRadius,
  boxsep=0pt,
  top={\dimexpr\MacBarHeight+\MacPanelTopGap+2.4mm\relax},
  bottom=5.0mm,
  left=\MacListingLeft,
  right=\MacListingRight,
  before skip=9pt,
  after skip=16pt,
  fuzzy shadow={0mm}{-.45mm}{.7mm}{.08mm}{white!88},
  fuzzy shadow={0mm}{2.2mm}{5.0mm}{.12mm}{black!7},
  fuzzy shadow={0mm}{7mm}{18mm}{.20mm}{black!3},
  underlay unbroken={\MacLightGlassBody},
  underlay first={\MacLightGlassBody},
  underlay middle={\MacLightGlassBody},
  underlay last={\MacLightGlassBody},
  overlay unbroken={\MacLightChrome{#3}},
  overlay first={\MacLightChrome{#3}},
  overlay middle={\beautybook@maclightrim},
  overlay last={\beautybook@maclightrim}
}

% =========================================================
